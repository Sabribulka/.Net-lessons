@WebApplication1_HostAddress = http://localhost:5246

GET {{WebApplication1_HostAddress}}/weatherforecast/
Accept: application/json
###
POST {{WebApplication1_HostAddress}}/todos
Content-Type: application/json

{
  "title": "Вивчити HTTP",
  "isDone": false
}

> {%
    client.global.set("todoId", response.body.id);

    client.test("Returns 201", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });

    client.test("Title equal", function () {
        client.assert(response.body.title == "Вивчити HTTP");
    });
%}
### POST - Empty data
POST {{WebApplication1_HostAddress}}/todos
Content-Type: application/json

{}

> {%
    client.test("Returns 400", function () {
        client.assert(response.status === 400, "Expected 400, got " + response.status);
    });
%}
### POST - Object with title null
POST {{WebApplication1_HostAddress}}/todos
Content-Type: application/json

{
  "title": null,
  "isDone": false 
}

> {%
    client.test("Returns 400", function () {
        client.assert(response.status === 400, "Expected 400, got " + response.status);
    });
%}
### Get all todos
GET {{WebApplication1_HostAddress}}/todos
### Update - existing item
PUT {{WebApplication1_HostAddress}}/todos/{{todoId}}
Content-Type: application/json

{
  "title": "Вивчити Piska",
  "isDone": true
}
> {%
    client.test("Returns 204", function () {
        client.assert(response.status === 204, "Expected 204, got " + response.status);
    });
%}
### Update - not existing id (expect 404)
PUT {{WebApplication1_HostAddress}}/todos/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "title": "Вивчити Piska",
  "isDone": true
}
> {%
    client.test("Returns 404", function () {
        client.assert(response.status === 404, "Expected 404, got " + response.status);
    });
%}
###
DELETE {{WebApplication1_HostAddress}}/todos/{{todoId}}
###
DELETE {{WebApplication1_HostAddress}}/todos/00000000-0000-0000-0000-000000000000
###
